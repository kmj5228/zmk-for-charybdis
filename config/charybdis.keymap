#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    macros {
        To1_macro: To1_macro {
            compatible = "zmk,behavior-macro";
            label = "To1_macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_EFF &rgb_ug RGB_COLOR_HSB(128,100,50) &to 0>;
        };

        To0_macro: To0_macro {
            compatible = "zmk,behavior-macro";
            label = "To0_macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_EFR &to 0>;
        };

        To2_macro: To2_macro {
            compatible = "zmk,behavior-macro";
            label = "To2_macro";
            #binding-cells = <0>;
            bindings =
                <&to 3>,
                <&macro_wait_time 30>,
                <&rgb_ug RGB_COLOR_HSB(250,100,50)>;
        };
    };

    combos {
        compatible = "zmk,combos";

        copy {
            bindings = <&kp LG(C)>;
            key-positions = <38 39>;
            require-prior-idle-ms = <100>;
        };

        cut {
            bindings = <&kp LG(X)>;
            key-positions = <38 37>;
            require-prior-idle-ms = <100>;
        };

        paste {
            bindings = <&kp LG(V)>;
            key-positions = <39 40>;
            require-prior-idle-ms = <100>;
            slow-release;
        };

        left_desk {
            bindings = <&kp LC(LEFT)>;
            key-positions = <26 27>;
            require-prior-idle-ms = <100>;
        };

        right_desk {
            bindings = <&kp LC(RIGHT)>;
            key-positions = <28 27>;
            require-prior-idle-ms = <100>;
        };

        mission_control {
            bindings = <&kp LC(UP_ARROW)>;
            key-positions = <26 27 28>;
            require-prior-idle-ms = <100>;
        };

        left_win {
            bindings = <&kp LG(GRAVE)>;
            key-positions = <25 26>;
            require-prior-idle-ms = <100>;
        };

        right_win {
            bindings = <&kp LG(LS(GRAVE))>;
            key-positions = <34 33>;
            require-prior-idle-ms = <100>;
        };

        left_parenthesis {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <31 32>;
            require-prior-idle-ms = <100>;
        };

        right_parenthesis {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <32 33>;
            require-prior-idle-ms = <100>;
        };

        left_brace {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <43 44>;
            require-prior-idle-ms = <100>;
        };

        right_brace {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <44 45>;
            require-prior-idle-ms = <100>;
        };

        left_bracket {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <19 20>;
            require-prior-idle-ms = <100>;
        };

        right_bracket {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <20 21>;
            require-prior-idle-ms = <100>;
        };

        lefthalf {
            bindings = <&kp LA(LG(LEFT))>;
            key-positions = <14 15>;
            require-prior-idle-ms = <100>;
        };

        righthalf {
            bindings = <&kp LA(LG(RIGHT))>;
            key-positions = <16 15>;
            require-prior-idle-ms = <100>;
        };

        full_win {
            bindings = <&kp LA(LG(F))>;
            key-positions = <16 15 14>;
            require-prior-idle-ms = <100>;
        };
    };

    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <130>;
            flavor = "tap-preferred";
        };

        td_copy: td_copy {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_COPY";
            #binding-cells = <0>;
            bindings = <&kp LG(C)>, <&ht_test LG(V) LG(X)>;

            tapping-term-ms = <350>;
        };

        ht_test: ht_test {
            compatible = "zmk,behavior-hold-tap";
            label = "HT_TEST";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <350>;
            flavor = "tap-preferred";
        };

        OSM_shift: OSM_shift {
            compatible = "zmk,behavior-sticky-key";
            label = "OSM_SHIFT";
            bindings = <&kp>;
            #binding-cells = <1>;
            release-after-ms = <200>;
            quick-release;
        };

        hms: homerow_shift {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_SHIFT";
            bindings = <&OSM_shift>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <130>;
            flavor = "tap-preferred";
        };

        lt_thumb: lt_thumb {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_THUMB";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <130>;
            flavor = "tap-preferred";
            retro-tap;
        };

        lt_alpha: lt_alpha {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_ALPHA";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <130>;
            flavor = "tap-preferred";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        QWERTY {
            bindings = <
&kp ESC       &kp N1          &kp N2        &kp N3           &kp N4             &kp N5             &kp N6                 &kp N7             &kp N8           &kp N9              &kp N0              &kp BACKSPACE
&kp TAB       &kp Q           &kp W         &kp E            &kp R              &kp T              &kp Y                  &kp U              &kp I            &kp O               &kp P               &kp BSLH
&kp CAPSLOCK  &hm LEFT_ALT A  &hms LSHFT S  &hm LEFT_GUI D   &hm LCTRL F        &kp G              &kp H                  &hm LCTRL J        &hm RIGHT_GUI K  &hms RIGHT_SHIFT L  &hm RIGHT_ALT SEMI  &kp SQT
&kp GRAVE     &kp Z           &kp X         &kp C            &kp V              &lt_alpha 3 B      &kp N                  &kp M              &kp COMMA        &kp DOT             &kp FSLH            &kp BACKSLASH
                                            &lt_alpha 1 TAB  &lt_alpha 2 ENTER  &lt_thumb 5 ESC    &lt_thumb 6 BACKSPACE  &lt_thumb 4 SPACE
                                                             &none              &none              &lt_thumb 5 DELETE
            >;
        };

        scroll-layers {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans    &trans  &trans     &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans    &trans  &trans     &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans    &trans  &trans     &trans  &trans
                        &trans  &trans  &trans    &trans    &trans
                                &trans  &trans    &trans
            >;
        };

        snipe-layers {
            bindings = <
&trans  &trans   &trans     &trans     &trans     &trans    &trans          &trans          &trans        &trans           &trans  &trans
&trans  &trans   &trans     &trans     &trans     &trans    &trans          &trans          &trans        &trans           &trans  &trans
&trans  &trans   &trans     &trans     &trans     &trans    &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &trans  &trans
&trans  &kp F15  &mkp MCLK  &mkp RCLK  &mkp LCLK  &trans    &trans          &trans          &trans        &trans           &trans  &trans
                            &trans     &trans     &trans    &mkp RCLK       &mkp LCLK
                                       &trans     &trans    &mkp MCLK
            >;
        };

        BT_layers {
            bindings = <
&trans  &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans      &trans  &trans  &trans  &trans  &trans
&trans  &trans          &trans        &trans        &trans        &trans          &trans      &trans  &trans  &trans  &trans  &trans
&trans  &bt BT_CLR_ALL  &trans        &trans        &trans        &trans          &trans      &trans  &trans  &trans  &trans  &trans
&trans  &trans          &trans        &bt BT_CLR    &trans        &trans          &bt BT_NXT  &trans  &trans  &trans  &trans  &trans
                                      &trans        &trans        &trans          &trans      &trans
                                                    &trans        &trans          &trans
            >;
        };

        NUM {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &kp N5  &kp N6  &kp N7  &kp N8  &kp N9  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &kp N0  &kp N1  &kp N2  &kp N3  &kp N4  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans
                                &trans  &trans    &trans
            >;
        };

        FUNC {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans   &trans   &trans   &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &kp F5   &kp F6   &kp F7   &kp F8  &kp F9  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &kp F10  &kp F1   &kp F2   &kp F3  &kp F4  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans   &kp F10  &kp F11  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans   &trans
                                &trans  &trans    &trans
            >;
        };

        SYM {
            bindings = <
&trans  &trans           &trans       &trans         &trans        &trans         &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans           &kp CARET    &kp AMPERSAND  &kp ASTERISK  &trans         &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp EXCLAMATION  &kp AT_SIGN  &kp POUND      &kp DOLLAR    &kp PERCENT    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp MINUS        &kp PLUS     &kp EQUAL      &trans        &trans         &trans  &trans  &trans  &trans  &trans  &trans
                                      &trans         &trans        &trans         &trans  &trans
                                                     &trans        &trans         &trans
            >;
        };
    };
};
